# Copy this file to .env and fill in your values
# Never commit your actual .env file

# ---- AI Agent (server-only; never exposed to the browser) ----
# Provider: openai (default) | groq
LLM_PROVIDER=openai
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini
# Groq is OpenAI-compatible; set LLM_PROVIDER=groq to use it instead
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# IANA timezone used to resolve "today" / "tomorrow" for the campus
CAMPUS_TIMEZONE=Asia/Dhaka

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Backend configuration
PORT=3000
