# Application
NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# MySQL (matches docker-compose.yml)
MYSQL_DATABASE=campusos
MYSQL_USER=campusos
MYSQL_PASSWORD=campusos_dev_password
MYSQL_ROOT_PASSWORD=campusos_root_password
DATABASE_URL=mysql://campusos:campusos_dev_password@localhost:3306/campusos

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Development authentication fallback; replace with an identity provider in production.
DEV_USER_ID=20-40532
