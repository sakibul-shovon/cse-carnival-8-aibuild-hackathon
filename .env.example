# Copy this file to .env and fill in your values
# Never commit your actual .env file

# LLM API Key (use whichever provider you choose)
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.4-mini
# ANTHROPIC_API_KEY=your_key_here
# GOOGLE_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here

# Backend / Database
DATABASE_URL=sqlite:///./campusos.db
PORT=8000
APP_TIMEZONE=Asia/Dhaka

# Hackathon MVP identity. The backend trusts this server-side value; clients cannot
# select another user or role. Replace this with real authentication after the MVP.
DEMO_USER_ID=usr-001
