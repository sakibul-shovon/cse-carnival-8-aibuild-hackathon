{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "sourceMap": true
  },
  "include": [
    "./**/*.ts",
    "../database/scripts/**/*.ts",
    "../tests/backend/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
