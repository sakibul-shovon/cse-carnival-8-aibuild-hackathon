generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum RoomType {
  CLASSROOM
  LAB
  SEMINAR
  AUDITORIUM
  STUDY
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  CLOSED
}

enum EventStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum NotificationSourceType {
  ANNOUNCEMENT
  ASSIGNMENT
  EVENT
  ROOM_BOOKING
  SCHEDULE
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id                    String                 @id @default(uuid()) @db.VarChar(36)
  externalId            String                 @unique @map("external_id") @db.VarChar(40)
  name                  String                 @db.VarChar(120)
  email                 String                 @unique @db.VarChar(190)
  role                  UserRole               @default(STUDENT)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  enrollments           CourseEnrollment[]
  roomBookings          RoomBooking[]
  eventRegistrations    EventRegistration[]
  assignmentSubmissions AssignmentSubmission[]
  notifications         Notification[]
  chatMessages          ChatMemory[]

  @@index([role])
  @@map("users")
}

model Course {
  id          String             @id @default(uuid()) @db.VarChar(36)
  code        String             @unique @db.VarChar(24)
  title       String             @db.VarChar(190)
  department  String             @db.VarChar(80)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  schedules   Schedule[]
  assignments Assignment[]
  enrollments CourseEnrollment[]

  @@index([department])
  @@map("courses")
}

model CourseEnrollment {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  courseId  String   @map("course_id") @db.VarChar(36)
  section   String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, section])
  @@index([courseId, section])
  @@map("course_enrollments")
}

model Room {
  id        String        @id @default(uuid()) @db.VarChar(36)
  number    String        @unique @db.VarChar(20)
  type      RoomType
  capacity  Int
  floor     Int
  status    RoomStatus    @default(AVAILABLE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  features  RoomFeature[]
  schedules Schedule[]
  bookings  RoomBooking[]
  events    CampusEvent[]

  @@index([type, capacity, status])
  @@index([floor])
  @@map("rooms")
}

model RoomFeature {
  id     String @id @default(uuid()) @db.VarChar(36)
  roomId String @map("room_id") @db.VarChar(36)
  name   String @db.VarChar(80)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, name])
  @@index([name])
  @@map("room_features")
}

model Schedule {
  id         String    @id @default(uuid()) @db.VarChar(36)
  courseId   String    @map("course_id") @db.VarChar(36)
  roomId     String    @map("room_id") @db.VarChar(36)
  dayOfWeek  DayOfWeek @map("day_of_week")
  startTime  DateTime  @map("start_time") @db.Time(0)
  endTime    DateTime  @map("end_time") @db.Time(0)
  instructor String    @db.VarChar(120)
  section    String    @db.VarChar(20)
  semester   String    @default("Fall 2026") @db.VarChar(40)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([dayOfWeek, startTime])
  @@index([courseId, section])
  @@index([roomId, dayOfWeek, startTime, endTime])
  @@map("schedules")
}

model RoomBooking {
  id        String   @id @default(uuid()) @db.VarChar(36)
  roomId    String   @map("room_id") @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  bookedBy  String   @map("booked_by") @db.VarChar(120)
  purpose   String   @db.VarChar(255)
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, startsAt, endsAt])
  @@index([userId, startsAt])
  @@map("room_bookings")
}

model CampusEvent {
  id            String              @id @default(uuid()) @db.VarChar(36)
  name          String              @db.VarChar(190)
  description   String?             @db.Text
  startsAt      DateTime            @map("starts_at")
  endsAt        DateTime            @map("ends_at")
  roomId        String?             @map("room_id") @db.VarChar(36)
  venueLabel    String              @map("venue_label") @db.VarChar(120)
  organizer     String              @db.VarChar(120)
  capacity      Int
  status        EventStatus         @default(UPCOMING)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  room          Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]

  @@index([startsAt, status])
  @@index([roomId, startsAt, endsAt])
  @@map("campus_events")
}

model EventRegistration {
  id           String      @id @default(uuid()) @db.VarChar(36)
  eventId      String      @map("event_id") @db.VarChar(36)
  userId       String      @map("user_id") @db.VarChar(36)
  registeredAt DateTime    @default(now()) @map("registered_at")
  event        CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, registeredAt])
  @@map("event_registrations")
}

model Announcement {
  id          String    @id @default(uuid()) @db.VarChar(36)
  title       String    @db.VarChar(190)
  body        String    @db.Text
  priority    Priority  @default(MEDIUM)
  postedBy    String    @map("posted_by") @db.VarChar(120)
  publishedAt DateTime  @default(now()) @map("published_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([priority, publishedAt])
  @@index([expiresAt])
  @@map("announcements")
}

model Assignment {
  id                 String                 @id @default(uuid()) @db.VarChar(36)
  courseId           String                 @map("course_id") @db.VarChar(36)
  title              String                 @db.VarChar(190)
  description        String?                @db.Text
  assignedAt         DateTime               @map("assigned_at")
  dueAt              DateTime               @map("due_at")
  submissionPlatform String                 @map("submission_platform") @db.VarChar(120)
  marks              Int
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  course             Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  submissions        AssignmentSubmission[]

  @@index([courseId, dueAt])
  @@index([dueAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(uuid()) @db.VarChar(36)
  assignmentId String           @map("assignment_id") @db.VarChar(36)
  userId       String           @map("user_id") @db.VarChar(36)
  status       AssignmentStatus @default(PENDING)
  submittedAt  DateTime?        @map("submitted_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([userId, status])
  @@map("assignment_submissions")
}

model Notification {
  id         String                 @id @default(uuid()) @db.VarChar(36)
  userId     String                 @map("user_id") @db.VarChar(36)
  sourceType NotificationSourceType @map("source_type")
  sourceId   String?                @map("source_id") @db.VarChar(36)
  message    String                 @db.VarChar(500)
  sendAt     DateTime               @map("send_at")
  status     NotificationStatus     @default(PENDING)
  createdAt  DateTime               @default(now()) @map("created_at")
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, sendAt])
  @@index([sendAt, status])
  @@index([sourceType, sourceId])
  @@map("notifications")
}

model ChatMemory {
  id        String   @id @default(uuid()) @db.VarChar(36)
  sessionId String   @map("session_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(36)
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@map("chat_memory")
}
